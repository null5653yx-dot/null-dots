/* * Catppuccin Mocha "Cinema Mode" Theme
 * maximized for image visibility
 */

configuration {
    show-icons: true;
}

* {
    /* Palette */
    bg-col:  #1e1e2e;
    bg-col-light: #1e1e2e;
    border-col: #cba6f7;
    selected-col: #1e1e2e;
    blue: #89b4fa;
    fg-col: #cdd6f4;
    fg-col2: #f38ba8;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    /* WIDER and TALLER */
    width: 1200px;
    height: 750px;
    border: 4px;
    border-color: @border-col;
    border-radius: 12px;
    background-color: @bg-col;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    padding: 20px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-col;
    border-radius: 6px;
    border: 2px;
    border-color: @blue;
    padding: 10px;
    margin: 0 0 20px 0;
}

prompt {
    background-color: @blue;
    padding: 6px;
    text-color: @bg-col;
    border-radius: 3px;
    margin: 0 10px 0 0;
}

entry {
    background-color: transparent;
    text-color: @fg-col;
    placeholder: "Search...";
    placeholder-color: #6c7086;
    vertical-align: 0.5;
}

listview {
    border: 0px;
    padding: 0px;
    margin: 0px;
    columns: 3;
    lines: 2;
    background-color: transparent;
    spacing: 15px;
}

element {
    orientation: vertical;
    background-color: transparent;
    text-color: @fg-col;
    border-radius: 10px;
    padding: 1px; /* Reduced padding to give image more room */
    border: 3px;
    border-color: transparent;
}

element selected {
    background-color: #313244;
    text-color: @blue;
    border: 3px;
    border-color: @border-col;
}

element-icon {
    /* The big change: massive icons */
    size: 260px;
    horizontal-align: 0.5;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    margin: 5px 0 0 0;
}
